# Supabase → Project Settings → Database → Connection string → Session pooler.
# Paste it into server/.env (gitignored), with your database password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

PORT=3000

# Dev only: serve this finished heat (our heat id) lap by lap as if it were live.
# REPLAY_HEAT=
