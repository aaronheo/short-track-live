// Copy to Secrets.xcconfig (gitignored), then fill in from Render:
// the service URL, and API_TOKEN from the service's Environment tab.
API_BASE_URL = https:/$()/short-track-live.onrender.com
API_TOKEN = paste-API_TOKEN-from-Render

// Your Apple team, for installing on your own iPhone (the ID shown in
// Xcode → Settings → Accounts; a free Personal Team works).
DEVELOPMENT_TEAM = YOUR_TEAM_ID
